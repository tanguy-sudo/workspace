{
  "name": "workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /workspace/app/",
    "build:local": "ng build --configuration development --base-href /",
    "measure:performance": "npm run build && node scripts/measure-performance.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --isolate=false",
    "verify": "npm run build && npm test -- --watch=false && npm exec tsc -- --noEmit -p tsconfig.app.json"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "dexie": "4.3.0",
    "rxjs": "~7.8.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
